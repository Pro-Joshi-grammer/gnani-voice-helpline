# Gnani — Telangana Scheme Helpline: environment template
# Copy to backend/.env and fill in real values. NEVER commit backend/.env.
#
# What the running backend actually reads (see backend/engine.py::_config
# and backend/voice_server.py):

# --- Gnani Vachana (STT + TTS) — required for the voice loop ---
GNANI_API_KEY=your_gnani_api_key_here
GNANI_LANGUAGE=te-IN
GNANI_TTS_MODEL=timbre-v2.5
GNANI_TTS_VOICE=Suhana

# --- HTTP server ---
HOST=127.0.0.1
PORT=8000

# --- Featherless (the single tiny parse-LLM call per turn) ---
FEATHERLESS_BASE_URL=https://api.featherless.ai/v1
FEATHERLESS_API_KEY=your_featherless_api_key_here
FEATHERLESS_LLM_MODEL=your_model_name_here

# --- CORS: comma-separated browser origins allowed to call the API ---
# Set this when the frontend is deployed separately (e.g. Cloudflare Pages):
WEB_ORIGINS=

# --- Optional self-hosted OpenAI-compatible fallback for the parse call ---
# SELF_HOSTED_BASE_URL=
# SELF_HOSTED_API_KEY=
# SELF_HOSTED_LLM_MODEL=
#
# (The old RAG-era RAG_*/EMBEDDING_* keys were not carried over: the
# rule-based engine does not read them.)
